<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE スタック(MemeBleRepository)と計測フォアグラウンドサービスが必要とする
         権限は core が宣言し、アプリ側へはマニフェストマージで伝播する。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 計測中の大まかな現在地(LocationSampler。設定「位置情報を残す」は既定 OFF)。
         実行時に要求するのは COARSE だけなので、システムのダイアログは
         「おおよその位置情報」になる。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 計測フォアグラウンドサービスに location 型を足すために要る（宣言のみの
         install-time 権限。実行時ダイアログは出ない）。型を足す理由は
         [MeasurementService.foregroundServiceType] のコメントを見ること。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application>
        <!--
            計測中にプロセスとCPUを生かし続けるためのフォアグラウンドサービス。
            BLEデバイスとの継続通信なので type は connectedDevice。
            location を併記するのは、画面OFF中も位置記録(LocationSampler)を
            続けるため。ここは宣言できる型の**和集合**で、実際に使う型は実行時に
            [MeasurementService.foregroundServiceType] が権限と設定を見て選ぶ。
        -->
        <service
            android:name="com.jins_jp.meme.core.service.MeasurementService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!--
            OSS ライセンス一覧ビューア。play-services-oss-licenses が宣言する
            これらの Activity は AppCompatActivity を継承しており Theme.AppCompat 系
            テーマが必須だが、アプリのテーマは Compose ベースで非 AppCompat のため
            クラッシュする。ここでテーマだけ上書きする。
        -->
        <activity
            android:name="com.google.android.gms.oss.licenses.OssLicensesMenuActivity"
            android:theme="@style/Theme.Core.OssLicenses"
            tools:node="merge" />
        <activity
            android:name="com.google.android.gms.oss.licenses.OssLicensesActivity"
            android:theme="@style/Theme.Core.OssLicenses"
            tools:node="merge" />

        <!--
            OSS ライセンス画面(旧レイアウト)にシステムバー/ActionBar 分の
            インセットを当てる ActivityLifecycleCallbacks を、アプリの Application を
            触らずに自動登録するための ContentProvider。
        -->
        <provider
            android:name="com.jins_jp.meme.core.ui.oss.OssLicensesInsetsInitializer"
            android:authorities="${applicationId}.core.osslicenses-insets"
            android:exported="false"
            android:initOrder="100" />
    </application>

</manifest>
