<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE・計測サービス関連の権限とサービス宣言は :core のマニフェストが
         宣言しており、マニフェストマージで取り込まれる。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- allowBackup="false" は必須。true にするとGoogleの自動バックアップ巡回
         (約12時間おき)の対象になり、巡回時に BackupManager が計測中の
         プロセスごとSIGKILLする(前面サービスでも容赦なく殺される)。
         サイドロード配布のため transport 側には毎回拒否されており、
         バックアップの実利はゼロで長時間計測だけが中断されていた。 -->
    <application
        android:name="com.jins_jp.meme.core.App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ESRDevKit2">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ESRDevKit2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
