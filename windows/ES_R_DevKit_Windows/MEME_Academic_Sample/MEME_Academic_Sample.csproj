<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MEME_Academic_Sample</RootNamespace>
    <!-- RootNamespace は据え置き。app.ico の埋め込みリソース名がこれに依存する。 -->
    <AssemblyName>JINS_MEME_DataLogger</AssemblyName>
    <Version>2.0.1</Version>
    <Product>JINS MEME DataLogger</Product>
    <AssemblyTitle>JINS MEME DataLogger</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ウィンドウのアイコンとして実行時に読み込む(Form.Icon)。 -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MEMELib_Academic\MEMELib_Academic.csproj" />
  </ItemGroup>

</Project>
