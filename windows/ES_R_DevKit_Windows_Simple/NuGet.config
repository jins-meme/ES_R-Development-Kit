<?xml version="1.0" encoding="utf-8"?>
<!--
  このマシンのグローバル NuGet 設定にはパッケージソースが登録されていないため、
  このソリューションの範囲だけで nuget.org を参照する。
  社内フィードを使う場合は value をそちらへ差し替えること。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
